generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionKind {
  PRODUCT_DISCOUNT
  BUNDLE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum PaymentMethod {
  YAPE
  CREDIT_CARD
  DEBIT_CARD
  PREPAID_CARD
}

enum InventoryMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

model User {
  id           String      @id @default(uuid()) @db.VarChar(36)
  email        String      @unique @db.VarChar(191)
  passwordHash String      @map("password_hash") @db.VarChar(255)
  firstName    String      @map("first_name") @db.VarChar(100)
  lastName     String      @map("last_name") @db.VarChar(100)
  phone        String?     @db.VarChar(30)
  role         UserRole    @default(CUSTOMER)
  active       Boolean     @default(true)
  deletedAt    DateTime?   @map("deleted_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  orders       Order[]
  sessions     Session[]
  auditLogs    AuditLog[]
  promotions   Promotion[] @relation("PromotionCreator")
  addresses    Address[]

  @@map("users")
}

model Address {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  label      String   @default("Casa") @db.VarChar(50)
  addressLine String  @map("address_line") @db.VarChar(255)
  reference  String?  @db.VarChar(255)
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  isDefault  Boolean  @default(true) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@map("addresses")
}

model Session {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  slug      String    @unique @db.VarChar(120)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("categories")
}

model Product {
  id                 String              @id @default(uuid()) @db.VarChar(36)
  categoryId         Int                 @map("category_id")
  name               String              @db.VarChar(150)
  description        String              @db.Text
  price              Decimal             @db.Decimal(10, 2)
  imageUrl           String?             @map("image_url") @db.Text
  stock              Int                 @default(0)
  active             Boolean             @default(true)
  deletedAt          DateTime?           @map("deleted_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  promotions         PromotionProduct[]

  @@index([categoryId])
  @@index([active])
  @@map("products")
}

model Promotion {
  id            String             @id @default(uuid()) @db.VarChar(36)
  name          String             @db.VarChar(150)
  description   String?            @db.Text
  kind          PromotionKind       @default(PRODUCT_DISCOUNT)
  discountType  DiscountType?       @map("discount_type")
  discountValue Decimal?            @map("discount_value") @db.Decimal(10, 2)
  bundlePrice   Decimal?            @map("bundle_price") @db.Decimal(10, 2)
  imageUrl      String?             @map("image_url") @db.Text
  startsAt      DateTime           @map("starts_at")
  endsAt        DateTime           @map("ends_at")
  active        Boolean            @default(true)
  deletedAt     DateTime?          @map("deleted_at")
  createdById   String             @map("created_by_id") @db.VarChar(36)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  createdBy     User               @relation("PromotionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  products      PromotionProduct[]
  orderItems    OrderItem[]

  @@index([active, startsAt, endsAt])
  @@index([createdById])
  @@map("promotions")
}

model PromotionProduct {
  promotionId String    @map("promotion_id") @db.VarChar(36)
  productId   String    @map("product_id") @db.VarChar(36)
  quantity    Int       @default(1)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([promotionId, productId])
  @@index([productId])
  @@map("promotion_products")
}

model Order {
  id              String      @id @default(uuid()) @db.VarChar(36)
  userId          String      @map("user_id") @db.VarChar(36)
  idempotencyKey  String      @unique @map("idempotency_key") @db.VarChar(100)
  status          OrderStatus @default(PENDING)
  customerName    String      @map("customer_name") @db.VarChar(200)
  customerEmail   String      @map("customer_email") @db.VarChar(191)
  customerPhone   String      @map("customer_phone") @db.VarChar(30)
  deliveryAddress String?     @map("delivery_address") @db.VarChar(255)
  deliveryLatitude Decimal?   @map("delivery_latitude") @db.Decimal(10, 7)
  deliveryLongitude Decimal?  @map("delivery_longitude") @db.Decimal(10, 7)
  notes           String?     @db.Text
  subtotal        Decimal     @db.Decimal(10, 2)
  deliveryFee     Decimal     @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  payment         Payment?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     String  @map("order_id") @db.VarChar(36)
  productId   String  @map("product_id") @db.VarChar(36)
  promotionId String? @map("promotion_id") @db.VarChar(36)
  promotionName String? @map("promotion_name") @db.VarChar(150)
  productName String  @map("product_name") @db.VarChar(150)
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  quantity    Int
  subtotal    Decimal @db.Decimal(10, 2)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([promotionId])
  @@map("order_items")
}

model Payment {
  id         String        @id @default(uuid()) @db.VarChar(36)
  orderId    String        @unique @map("order_id") @db.VarChar(36)
  provider   String        @db.VarChar(50)
  method     PaymentMethod
  externalId String?       @unique @map("external_id") @db.VarChar(191)
  status     PaymentStatus @default(PENDING)
  amount     Decimal       @db.Decimal(10, 2)
  paidAt     DateTime?     @map("paid_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @map("user_id") @db.VarChar(36)
  action     String   @db.VarChar(100)
  entity     String   @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  metadata   Json?
  occurredAt DateTime @default(now()) @map("occurred_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([occurredAt])
  @@map("audit_logs")
}

model InventoryMovement {
  id        Int                   @id @default(autoincrement())
  productId String                @map("product_id") @db.VarChar(36)
  type      InventoryMovementType
  quantity  Int
  reason    String?               @db.VarChar(255)
  reference String?               @db.VarChar(100)
  createdAt DateTime              @default(now()) @map("created_at")
  product   Product               @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([createdAt])
  @@map("inventory_movements")
}
