{
  "name": "el-poblano",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,green \"npm run dev -w @elpoblano/frontend\" \"npm run dev -w @elpoblano/backend\"",
    "dev:frontend": "npm run dev -w @elpoblano/frontend",
    "dev:backend": "npm run dev -w @elpoblano/backend",
    "build": "npm run build -w @elpoblano/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @elpoblano/backend",
    "test:system:prepare": "node scripts/prepareSystemTestEvidence.js",
    "test:acceptance:prepare": "node scripts/prepareAcceptanceEvidence.js",
    "test:selenium": "node scripts/runSeleniumEvidence.js",
    "test:load": "node scripts/runJMeterEvidence.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "selenium-webdriver": "^4.46.0"
  }
}
