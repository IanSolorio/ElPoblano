{
  "name": "el-poblano",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,green \"npm run dev -w @elpoblano/frontend\" \"npm run dev -w @elpoblano/backend\"",
    "dev:frontend": "npm run dev -w @elpoblano/frontend",
    "dev:backend": "npm run dev -w @elpoblano/backend",
    "build": "npm run build -w @elpoblano/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
