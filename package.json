{
  "name": "el-poblano",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,green \"npm run dev -w @elpoblano/frontend\" \"npm run dev -w @elpoblano/backend\"",
    "dev:frontend": "npm run dev -w @elpoblano/frontend",
    "dev:backend": "npm run dev -w @elpoblano/backend",
    "build": "npm run build -w @elpoblano/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @elpoblano/backend",
    "test:phase5": "node scripts/runPhase5.js",
    "test:frontend": "npm run test -w @elpoblano/frontend",
    "test:frontend:coverage": "npm run test:coverage -w @elpoblano/frontend",
    "test:selenium": "node scripts/runSeleniumEvidence.js",
    "test:jmeter": "node scripts/runJMeterPhase6.js",
    "test:ec2": "bash scripts/runEc2SystemTests.sh",
    "sonar:prepare": "node scripts/prepareSonarCoverage.js",
    "sonar:analyze": "node scripts/runSonarAnalysis.js",
    "sonar:collect": "node scripts/runSonarAnalysis.js --collect-only",
    "quality:consolidate": "node scripts/consolidateQualityResults.js",
    "quality:jmeter:consolidate": "node scripts/consolidateJMeterEvidence.js"
  },
  "devDependencies": {
    "@sonar/scan": "^5.0.0",
    "concurrently": "^9.2.0",
    "selenium-webdriver": "^4.46.0"
  }
}
